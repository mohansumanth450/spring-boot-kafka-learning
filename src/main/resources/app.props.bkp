server.port=1990
spring.application.name=spring-boot-kafka-learning

spring.kafka.consumer.bootstrap-servers=localhost:9092
spring.kafka.consumer.group-id= MohanConsumerGroup
# If there is no initial offset for the consumer group, start consuming from the earliest message
spring.kafka.consumer.auto-offset-reset=earliest
spring.kafka.consumer.enable-auto-commit=true
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
#spring.kafka.consumer.value-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.springframework.kafka.support.serializer.ErrorHandlingDeserializer
spring.kafka.consumer.properties.spring.deserializer.value.delegate.class=org.springframework.kafka.support.serializer.JsonDeserializer
# Required in most cases when no __TypeId__ header exists in the message
spring.kafka.consumer.properties.spring.json.value.default.type = com.mohankafka.springbootkafkalearning.payload.User
# Very helpful (prevents security warnings in newer versions)
spring.kafka.consumer.properties.spring.json.trusted.packages=*
# default is true → set false to ignore headers and rely on the default type specified above
spring.kafka.consumer.properties.spring.json.use.type.headers = false


spring.kafka.producer.bootstrap-servers=localhost:9092
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
#spring.kafka.producer.value-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer

spring.kafka.admin.bootstrap-servers=localhost:9092
